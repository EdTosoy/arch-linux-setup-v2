# i3 config file (v4) - 100% Screen Usage / Gruvbox
set $mod Mod4

# Fonts
font pango:Proxima Nova 12

# --- 100% SCREEN USAGE MODS ---
gaps inner 0
gaps outer 0
default_border pixel 2
default_floating_border pixel 2
smart_borders on
hide_edge_borders both
focus_follows_mouse no
floating_modifier $mod

# Autostart

# Load XDG autostart (.desktop apps)
exec --no-startup-id dex --autostart --environment i3

# NetworkManager tray (optional but useful)
exec --no-startup-id nm-applet

# Compositor (comment out if you get glitches)
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# Disable screen blanking / DPMS
exec_always --no-startup-id xset s off
exec_always --no-startup-id xset -dpms

# Fix cursor issues
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# Wallpaper (MUST be exec_always)
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/.config/i3/batArch.webp

# Display Setup (Corrected for your DP3 monitor)
exec --no-startup-id xrandr --output DP3 --mode 1920x1080 --rate 100.00 --primary

# Variables & Workspace Refresh
set $refresh_i3status killall -SIGUSR1 i3status

# Wallpaper shortcut
bindsym $mod+Shift+s exec feh --bg-scale ~/wallpapers/streetsig.jpg

# Basic Window Controls
bindsym $mod+Return exec --no-startup-id kitty
bindsym $mod+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun -font 'Hack 11'
bindsym $mod+m exec ~/.config/i3/scripts/powermenu

# --- CUSTOM APPLICATION SHORTCUTS ---
bindsym $mod+n exec --no-startup-id kitty yazi
bindsym $mod+w exec --no-startup-id zen-browser
bindsym $mod+c exec --no-startup-id antigravity
bindsym $mod+Escape exec --no-startup-id kitty -e htop

# Focus Controls (Vim style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move Controls
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# --- LAYOUT CONTROLS ---
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Cycle through windows on the current workspace
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

workspace_auto_back_and_forth yes
bindsym $mod+b workspace back_and_forth

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Multi-monitor movement
bindsym $mod+Right move workspace to output right
bindsym $mod+Left move workspace to output left
bindsym $mod+Up move workspace to output up
bindsym $mod+Down move workspace to output down

# System Controls
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Resize Mode
mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- Audio Controls ---
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 5%+ --limit 1.0 && pkill -RTMIN+1 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 5%- && pkill -RTMIN+1 i3blocks
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+1 i3blocks
bindsym XF86AudioMicMute     exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# --- Media ---
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym Print exec flameshot gui

# --- COLORS (Gruvbox Green) ---
set $bg #282828
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d68
set $gray #a89984
set $darkgray #1d2021
set $white #ffffff

# Window Decoration Colors
client.focused          $green  $green  $darkgray $green    $green
client.focused_inactive $darkgray $darkgray $yellow $darkgray $darkgray
client.unfocused        $darkgray $darkgray $yellow $darkgray $darkgray
client.urgent           $red    $red    $white    $red      $red

gaps inner 1

